{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/channel/provider-sync.schema.json",
  "title": "ProviderChannelSyncContract",
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "public_key_fingerprint", "tenant_id", "owner_id", "display_name", "device_kind", "manifest", "manifest_revision", "approved", "revoked", "connected"],
      "properties": {
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "public_key_fingerprint": {"type": "string", "minLength": 1, "maxLength": 512},
        "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "owner_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "display_name": {"type": "string", "maxLength": 256},
        "device_kind": {"type": "string", "minLength": 1, "maxLength": 96},
        "manifest": {"$ref": "../device/manifest.schema.json"},
        "manifest_revision": {"type": "string", "minLength": 1, "maxLength": 96},
        "approved": {"type": "boolean"},
        "revoked": {"type": "boolean"},
        "connected": {"type": "boolean"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operation_id", "hub_id", "device"],
      "properties": {
        "operation": {"const": "channel.sync-device"},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "hub_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "device": {"$ref": "#/$defs/device"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "purpose", "kinds", "binding_format", "issued_at_ms", "expires_at_ms", "opaque_binding"],
      "properties": {
        "channel_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 96},
        "kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["reliable-data", "realtime-data", "audio", "video"]}
        },
        "binding_format": {"type": "string", "minLength": 1, "maxLength": 128},
        "issued_at_ms": {"type": "integer", "minimum": 0},
        "expires_at_ms": {"type": "integer", "minimum": 0},
        "opaque_binding": {"type": "string", "minLength": 1, "maxLength": 87384}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "operation_id", "device_id", "manifest_revision", "channels"],
      "properties": {
        "operation": {"const": "channel.assignments"},
        "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "manifest_revision": {"type": "string", "minLength": 1, "maxLength": 96},
        "channels": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/assignment"}}
      }
    }
  }
}
