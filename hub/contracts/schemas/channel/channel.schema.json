{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/channel/channel.schema.json",
  "title": "ChannelGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "request_id", "channel_id", "profile_name", "lease_expires_at_ms", "opaque_binding"],
  "properties": {
    "operation": {"const": "channel.grant"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "channel_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile_name": {"type": "string", "minLength": 1, "maxLength": 96},
    "lease_expires_at_ms": {"type": "integer", "minimum": 0},
    "opaque_binding": {"type": "string", "minLength": 1, "maxLength": 87384}
  }
}
