{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/channel/channel.schema.json",
  "title": "ChannelGrant",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "operation_id", "channel_id", "purpose", "kinds", "binding_format", "issued_at_ms", "lease_expires_at_ms", "opaque_binding"],
  "properties": {
    "operation": {"const": "channel.grant"},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "channel_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 96},
    "kinds": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["reliable-data", "realtime-data", "audio", "video"]}
    },
    "binding_format": {"type": "string", "minLength": 1, "maxLength": 128},
    "issued_at_ms": {"type": "integer", "minimum": 0},
    "lease_expires_at_ms": {"type": "integer", "minimum": 0},
    "opaque_binding": {"type": "string", "minLength": 1, "maxLength": 87384}
  }
}
