{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/channel/acquisition.schema.json",
  "title": "DeviceChannelAcquisitionContract",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "session_id", "lease_token"],
      "properties": {
        "operation": {"const": "channel.acquire"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_token": {"type": "string", "minLength": 16, "maxLength": 512}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "device_id", "manifest_revision", "channels"],
      "properties": {
        "operation": {"const": "channel.acquired"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "manifest_revision": {"type": "string", "minLength": 1, "maxLength": 96},
        "channels": {"type": "array", "maxItems": 16, "items": {"$ref": "assignment.schema.json"}}
      }
    }
  }
}
