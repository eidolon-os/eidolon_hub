{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/onboarding/handoff.schema.json",
  "title": "DeviceHandoffContract",
  "oneOf": [
    {"$ref": "#/$defs/DeviceHandoffRequest"},
    {"$ref": "#/$defs/DeviceHandoffOutcome"}
  ],
  "$defs": {
    "DeviceHandoffRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request_id", "retrieval_token"],
      "properties": {
        "operation": {"const": "device.handoff"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "retrieval_token": {"type": "string", "minLength": 32, "maxLength": 256}
      }
    },
    "DeviceHandoffOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request_id", "enrollment_id", "device_id", "manifest_revision", "lifecycle_state", "device_ref", "channels"],
      "properties": {
        "operation": {"const": "device.handoff-outcome"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "enrollment_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "manifest_revision": {"type": "string", "minLength": 1, "maxLength": 96},
        "lifecycle_state": {"$ref": "../common/device-lifecycle-state.schema.json"},
        "device_ref": {
          "oneOf": [
            {"$ref": "#/$defs/DeviceRef"},
            {"type": "null"}
          ]
        },
        "channels": {"type": "array", "maxItems": 16, "items": {"$ref": "../channel/assignment.schema.json"}}
      }
    },
    "DeviceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_instance_id", "owner_domain_id", "owner_domain_generation", "claim_generation", "trust_epoch", "accepted_manifest_digest"],
      "properties": {
        "device_instance_id": {"type": "string", "minLength": 3, "maxLength": 128},
        "owner_domain_id": {"type": "string", "minLength": 3, "maxLength": 128},
        "owner_domain_generation": {"type": "integer", "minimum": 1},
        "claim_generation": {"type": "integer", "minimum": 1},
        "trust_epoch": {"type": "integer", "minimum": 1},
        "accepted_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
