{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/device/management.schema.json",
  "title": "Device Management Mutations",
  "oneOf": [
    { "$ref": "#/$defs/DeviceApprovalRequest" },
    { "$ref": "#/$defs/DevicePairingClaimRequest" },
    { "$ref": "#/$defs/DeviceRevocationRequest" }
  ],
  "$defs": {
    "DeviceApprovalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request_id", "owner_id"],
      "properties": {
        "operation": { "const": "device.approval" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "DevicePairingClaimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request_id", "pairing_secret"],
      "properties": {
        "operation": { "const": "device.pairing-claim" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "pairing_secret": { "type": "string", "minLength": 32, "maxLength": 256 }
      }
    },
    "DeviceRevocationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "request_id"],
      "properties": {
        "operation": { "const": "device.revocation" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 96 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 256, "default": "operator-request" }
      }
    }
  }
}
