{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/device/status.schema.json",
  "title": "Device Lifecycle Status",
  "type": "object", "additionalProperties": false,
  "required": ["operation", "device_id", "lifecycle_state"],
  "properties": {
    "operation": { "const": "device.lifecycle-status" }, "device_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "owner_id": { "type": ["string", "null"], "maxLength": 64 },
    "lifecycle_state": { "$ref": "../common/device-lifecycle-state.schema.json" }
  }
}
