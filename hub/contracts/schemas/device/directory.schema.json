{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.ai/contracts/device/directory.schema.json",
  "title": "Device Directory Entry",
  "type": "object", "additionalProperties": false,
  "required": ["operation", "device_id", "owner_scope", "display_name", "device_kind", "manifest_json", "manifest_revision", "approved", "revoked", "online", "sessions", "registered_at", "updated_at", "revision"],
  "properties": {
    "operation": { "const": "device.directory-entry" }, "device_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "owner_scope": { "type": "string", "minLength": 1, "maxLength": 64 }, "display_name": { "type": "string", "maxLength": 128 }, "device_kind": { "type": "string", "minLength": 1, "maxLength": 96 },
    "manifest_json": { "type": "string", "minLength": 2, "maxLength": 262144 }, "manifest_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "approved": { "type": "boolean" }, "revoked": { "type": "boolean" }, "online": { "type": "boolean" },
    "sessions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/session" } },
    "registered_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" }, "revision": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "expires_at"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
