{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/device/directory.schema.json",
  "title": "Device Directory Entry",
  "type": "object", "additionalProperties": false,
  "required": ["operation", "device_id", "owner_scope", "display_name", "device_kind", "manifest", "manifest_revision", "lifecycle_state", "enrolled_at", "updated_at"],
  "properties": {
    "operation": { "const": "device.directory-entry" }, "device_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "owner_scope": { "type": "string", "minLength": 1, "maxLength": 64 }, "display_name": { "type": "string", "maxLength": 128 }, "device_kind": { "type": "string", "minLength": 1, "maxLength": 96 },
    "manifest": { "$ref": "manifest.schema.json" }, "manifest_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "lifecycle_state": { "$ref": "../common/device-lifecycle-state.schema.json" },
    "enrolled_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" }
  }
}
