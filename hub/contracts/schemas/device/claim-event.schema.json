{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/device/claim-event.schema.json",
  "title": "Claim Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "stream_position", "event_id", "event_type", "device_ref", "aggregate_revision", "correlation_id", "causation_id", "occurred_at", "reason"],
  "properties": {
    "operation": { "const": "device.claim-event" },
    "stream_position": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_type": { "const": "live.eidolon.device.claim-revoked.v1" },
    "device_ref": { "$ref": "claim-revocation-result.schema.json#/$defs/DeviceRef" },
    "aggregate_revision": { "type": "integer", "minimum": 1 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
