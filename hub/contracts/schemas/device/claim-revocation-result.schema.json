{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/device/claim-revocation-result.schema.json",
  "title": "Claim Revocation Result",
  "$defs": {
    "DeviceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_instance_id", "owner_domain_id", "owner_domain_generation", "claim_generation", "trust_epoch", "accepted_manifest_digest"],
      "properties": {
        "device_instance_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "owner_domain_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "owner_domain_generation": { "type": "integer", "minimum": 1 },
        "claim_generation": { "type": "integer", "minimum": 1 },
        "trust_epoch": { "type": "integer", "minimum": 1 },
        "accepted_manifest_digest": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "command_id", "outcome", "device_ref", "aggregate_revision", "occurred_at", "event_id", "lifecycle_state"],
  "properties": {
    "operation": { "const": "device.claim-revocation-result" },
    "command_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "outcome": { "enum": ["committed", "replayed"] },
    "device_ref": { "$ref": "#/$defs/DeviceRef" },
    "aggregate_revision": { "type": "integer", "minimum": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "event_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "lifecycle_state": { "const": "revoked" }
  }
}
