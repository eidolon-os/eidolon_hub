{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/device/command.schema.json",
  "title": "DeviceCommandRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "request_id", "command_name", "arguments_json", "ttl_ms"],
  "properties": {
    "operation": {"const": "device.command"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "command_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "arguments_json": {"type": "string", "minLength": 2, "maxLength": 262144},
    "ttl_ms": {"type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000}
  }
}
