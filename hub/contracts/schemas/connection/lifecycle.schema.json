{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/connection/lifecycle.schema.json",
  "title": "ConnectionLifecycleMessage",
  "oneOf": [
    {"$ref": "#/$defs/hello"}, {"$ref": "#/$defs/challenge"},
    {"$ref": "#/$defs/proof"}, {"$ref": "#/$defs/accepted"},
    {"$ref": "#/$defs/heartbeat"}, {"$ref": "#/$defs/closed"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["operation", "request_id"],
      "properties": {
        "operation": {"type": "string"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "hello": {
      "allOf": [{"$ref": "#/$defs/base"}, {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "request_id", "device_id", "connector_id", "client_nonce"],
        "properties": {
          "operation": {"const": "connection.hello"}, "request_id": {"type": "string"},
          "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "connector_id": {"type": "string", "minLength": 1, "maxLength": 96},
          "client_nonce": {"type": "string", "minLength": 16, "maxLength": 256}
        }
      }]
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "challenge_id", "server_nonce", "expires_at_ms"],
      "properties": {
        "operation": {"const": "connection.challenge"}, "request_id": {"type": "string"},
        "challenge_id": {"type": "string"}, "server_nonce": {"type": "string", "minLength": 16},
        "expires_at_ms": {"type": "integer", "minimum": 0}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "challenge_id", "device_id", "public_key", "signature"],
      "properties": {
        "operation": {"const": "connection.proof"}, "request_id": {"type": "string"},
        "challenge_id": {"type": "string"}, "device_id": {"type": "string"},
        "public_key": {"type": "string"}, "signature": {"type": "string"}
      }
    },
    "accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "connection_id", "lease_token", "lease_expires_at_ms", "heartbeat_after_ms", "registration_required"],
      "properties": {
        "operation": {"const": "connection.accepted"}, "request_id": {"type": "string"},
        "connection_id": {"type": "string"}, "lease_token": {"type": "string", "minLength": 16},
        "lease_expires_at_ms": {"type": "integer"}, "heartbeat_after_ms": {"type": "integer", "minimum": 1000},
        "registration_required": {"type": "boolean"}
      }
    },
    "heartbeat": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "connection_id", "lease_token", "sequence"],
      "properties": {
        "operation": {"const": "connection.heartbeat"}, "request_id": {"type": "string"},
        "connection_id": {"type": "string"}, "lease_token": {"type": "string", "minLength": 16},
        "sequence": {"type": "integer", "minimum": 1}
      }
    },
    "closed": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "device_id", "connection_id", "lease_token", "reason"],
      "properties": {
        "operation": {"const": "connection.closed"}, "request_id": {"type": "string"},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "connection_id": {"type": "string"}, "lease_token": {"type": "string", "minLength": 16},
        "reason": {"enum": ["client", "server", "lease-expired", "revoked"]}
      }
    }
  }
}
