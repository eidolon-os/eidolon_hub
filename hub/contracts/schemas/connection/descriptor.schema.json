{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.ai/contracts/connection/descriptor.schema.json",
  "title": "Hub Descriptor",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "hub_id", "descriptor_uri", "https_registration_uri", "protocol_versions"],
  "properties": {
    "schema_version": { "const": 1 }, "hub_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "descriptor_uri": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "https_registration_uri": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
    "mqtt_endpoint_uri": { "type": ["string", "null"], "format": "uri", "pattern": "^mqtts://", "maxLength": 2048 },
    "protocol_versions": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } }
  }
}
