{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidolon.dev/contracts/session/lifecycle.schema.json",
  "title": "DeviceSessionLifecycleMessage",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/challenge"},
    {"$ref": "#/$defs/proof"},
    {"$ref": "#/$defs/accepted"},
    {"$ref": "#/$defs/heartbeat"},
    {"$ref": "#/$defs/closed"}
  ],
  "$defs": {
    "hello": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "device_id", "client_nonce"],
      "properties": {
        "operation": {"const": "session.hello"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "client_nonce": {"type": "string", "minLength": 16, "maxLength": 256}
      }
    },
    "challenge": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "challenge_id", "server_nonce", "expires_at_ms"],
      "properties": {
        "operation": {"const": "session.challenge"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "challenge_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "server_nonce": {"type": "string", "minLength": 16, "maxLength": 256},
        "expires_at_ms": {"type": "integer", "minimum": 0}
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "challenge_id", "device_id", "public_key", "signature"],
      "properties": {
        "operation": {"const": "session.proof"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "challenge_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "public_key": {"type": "string", "minLength": 32, "maxLength": 4096},
        "signature": {"type": "string", "minLength": 32, "maxLength": 4096}
      }
    },
    "accepted": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "session_id", "lease_token", "lease_expires_at_ms", "heartbeat_after_ms", "registration_required"],
      "properties": {
        "operation": {"const": "session.accepted"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_token": {"type": "string", "minLength": 16, "maxLength": 512},
        "lease_expires_at_ms": {"type": "integer", "minimum": 0},
        "heartbeat_after_ms": {"type": "integer", "minimum": 1000, "maximum": 300000},
        "registration_required": {"type": "boolean"}
      }
    },
    "heartbeat": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "session_id", "lease_token", "sequence"],
      "properties": {
        "operation": {"const": "session.heartbeat"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_token": {"type": "string", "minLength": 16, "maxLength": 512},
        "sequence": {"type": "integer", "minimum": 1}
      }
    },
    "closed": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "request_id", "device_id", "session_id", "lease_token", "reason"],
      "properties": {
        "operation": {"const": "session.closed"},
        "request_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "lease_token": {"type": "string", "minLength": 16, "maxLength": 512},
        "reason": {"enum": ["client", "server", "lease-expired", "revoked"]}
      }
    }
  }
}
