# Hub control-plane credentials (minimum 32 random bytes each).
# Empty values intentionally make startup fail until real secrets are supplied.
# EIDOLON_HUB_PROFILE=local
# Cloud replicas require a unique value, normally the Pod/instance identity.
# EIDOLON_HUB_INSTANCE_ID=eidolon-hub-cloud-0
# EIDOLON_HUB_DATA_DIR=/var/lib/eidolon-hub
EIDOLON_HUB_LEASE_SECRET=
EIDOLON_HUB_MANAGEMENT_JWT_SECRET=
EIDOLON_HUB_CHANNEL_PROVIDER_TOKEN=
# PostgreSQL credentials are required only by the Cloud/PostgreSQL profile.
EIDOLON_HUB_POSTGRES_USER=
EIDOLON_HUB_POSTGRES_PASSWORD=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
