# Three-plane control-plane credentials (minimum 32 bytes for the lease key).
EIDOLON_HUB_LEASE_SECRET=replace-with-at-least-32-random-bytes
EIDOLON_HUB_MANAGEMENT_JWT_SECRET=replace-with-at-least-32-random-bytes
EIDOLON_HUB_PROVIDER_TOKEN=replace-with-at-least-32-random-bytes
