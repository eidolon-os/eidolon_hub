# 复制到仓库根目录为 .env 后使用（与 deploy/dev 配套）
#
# LiveKit API 凭据须与本目录 livekit.yaml 中 keys 一致

LIVEKIT_API_KEY=eidolon
LIVEKIT_API_SECRET=eidolon-livekit-secret-2026

# Hub 调 LiveKit HTTP API（管理接口）
# LIVEKIT_URL=http://127.0.0.1:7880

# 下发给客户端的 LiveKit 信令地址（任选其一策略，见仓库 README）
# EIDOLON_LIVEKIT_URL=ws://127.0.0.1:7880
# 或：EIDOLON_LIVEKIT_IP=192.168.1.10 + EIDOLON_LIVEKIT_PORT=7880
# 或：EIDOLON_LIVEKIT_IP=auto（与请求 Hub 的 Host 同主机名）+ EIDOLON_LIVEKIT_PORT=7880
