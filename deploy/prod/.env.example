# 复制为同目录下的 .env 后执行: docker compose up -d
#
# LIVEKIT_API_* 须与本目录 livekit.yaml 中 keys 一致

LIVEKIT_API_KEY=eidolon
LIVEKIT_API_SECRET=eidolon-livekit-secret-2026

# Hub 容器访问宿主机上的 LiveKit（livekit 服务使用 host 网络，监听 7880）
LIVEKIT_URL=http://host.docker.internal:7880

# 终端设备 / mDNS 等使用的 LiveKit URL（浏览器或 ESP32 能访问到的地址）
# 公网示例: wss://livekit.example.com
# 局域网示例: ws://192.168.1.10:7880
EIDOLON_LIVEKIT_URL=ws://127.0.0.1:7880

# Next.js 构建期注入（须为「用户浏览器」能访问的 URL，不要用 host.docker.internal）
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
NEXT_PUBLIC_LIVEKIT_TOKEN_URL=http://127.0.0.1:8081/api/web/config
NEXT_PUBLIC_APP_TITLE=Eidolon Agent

# Admin 构建期注入（须为浏览器可访问的 Hub Admin API）
VITE_ADMIN_API_BASE=http://127.0.0.1:8081/api/admin
