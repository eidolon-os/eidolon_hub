# context: repository root
FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_ADMIN_API_BASE=http://127.0.0.1:8081/api/admin
ENV VITE_ADMIN_API_BASE=$VITE_ADMIN_API_BASE

COPY client/admin/package.json client/admin/package-lock.json ./
RUN npm ci

COPY client/admin ./
RUN npm run build

FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

EXPOSE 5174

CMD ["serve", "-s", "dist", "-l", "5174"]
