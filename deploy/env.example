# Eidolon Hub Runtime Environment Variables
# 复制为 deploy/.env 并根据实际环境修改

# =============================================
# API 服务配置 (可选，默认端口 8081)
# =============================================
# EIDOLON_API_HOST=0.0.0.0
# EIDOLON_API_PORT=8081

# =============================================
# LiveKit 配置
# =============================================
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your_secret_here
EIDOLON_ESP32_ROOM_NAME=ai-assistant-room
EIDOLON_LIVEKIT_URL=wss://livekit-server.yangtzeailab.com

# =============================================
# 日志配置 (可选)
# =============================================
# EIDOLON_LOG_LEVEL=INFO

# =============================================
# 可选：指定 YAML 配置文件路径
# =============================================
# EIDOLON_HUB_CONFIG=/opt/eidolon-hub/config/production.yaml
