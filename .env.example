# Eidolon Hub 统一环境变量模板（dev / prod 通用）
#
# 用法：在仓库根目录 `cp .env.example .env`，按本机环境填写。
# 加载方式：hub/config.py 通过 python-dotenv 的 load_dotenv() 读取仓库根 .env。

# =============================================
# LiveKit 配置
# =============================================
# LiveKit API Key（须与当前运行环境中的 LiveKit 配置里 keys 一致）
LIVEKIT_API_KEY=eidolon
# LiveKit API Secret
LIVEKIT_API_SECRET=eidolon-livekit-secret-2026
# LiveKit 服务端管理 API 地址（Hub 后端调用，必须为 http:// 或 https://；
# 客户端信令 ws(s):// 请配置在 EIDOLON_LIVEKIT_URL 或 EIDOLON_LIVEKIT_IP）
# LIVEKIT_API_URL=http://127.0.0.1:7880

# 终端（ESP32 等）连接的 LiveKit 信令地址（三选一，优先级从上到下）
# 1) 完整 ws(s) URL（最高优先级）
# EIDOLON_LIVEKIT_URL=wss://livekit.example.com
# 2) 主机 + 端口（EIDOLON_LIVEKIT_IP 非空且不为 auto）
# EIDOLON_LIVEKIT_IP=192.168.3.204
# EIDOLON_LIVEKIT_PORT=7880
# EIDOLON_LIVEKIT_SCHEME=ws
# 3) 与访问 Hub 的 Host 相同（EIDOLON_LIVEKIT_IP 留空或设为 auto）
# EIDOLON_LIVEKIT_IP=auto
# EIDOLON_LIVEKIT_PORT=7880
# EIDOLON_LIVEKIT_SCHEME=

# =============================================
# API 服务配置 (可选)
# =============================================
# HUB_HOST=0.0.0.0
# HUB_PORT=8081

# =============================================
# 日志配置 (可选)
# =============================================
# LOG_LEVEL=INFO

# =============================================
# mDNS 发现配置 (可选)
# =============================================
# MDNS_SERVICE_TYPE=_eidolon-hub._tcp.local.
# MDNS_SERVICE_NAME=Eidolon Hub._eidolon-hub._tcp.local.
# MDNS_HOSTNAME=eidolon-hub
# MDNS_TXT_VERSION=1
# MDNS_API_VERSION=v1
# MDNS_CONFIG_PATH=/api/config

# =============================================
# Admin 探测配置 (可选)
# =============================================
# ADMIN_PROBE_ENABLED=true
# ADMIN_PROBE_INTERVAL_SECONDS=10
# ADMIN_DEGRADED_AFTER_MISSED_PROBES=2
# ADMIN_OFFLINE_AFTER_MISSED_PROBES=3
# ADMIN_COMMAND_TIMEOUT_SECONDS=30
