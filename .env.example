# Eidolon Hub API 环境变量配置
# 复制到项目根目录 .env 并根据实际环境修改

# =============================================
# LiveKit 配置
# =============================================
# LiveKit API Key (需与 deploy/livekit/livekit.yaml 中一致)
LIVEKIT_API_KEY=eidolon
# LiveKit API Secret
LIVEKIT_API_SECRET=eidolon-livekit-secret-2026
# LiveKit API URL (用于服务器侧管理接口; 支持 http(s):// 或 ws(s)://)
# LIVEKIT_URL=https://livekit-server.yangtzeailab.com

# ESP32 设备连接的 LiveKit 服务器地址
EIDOLON_LIVEKIT_URL=wss://livekit-server.yangtzeailab.com

# =============================================
# API 服务配置 (可选)
# =============================================
# HUB_HOST=0.0.0.0
# HUB_PORT=8081

# =============================================
# 日志配置 (可选)
# =============================================
# LOG_LEVEL=INFO

# =============================================
# mDNS 发现配置 (可选)
# =============================================
# MDNS_SERVICE_TYPE=_eidolon-hub._tcp.local.
# MDNS_SERVICE_NAME=Eidolon Hub._eidolon-hub._tcp.local.
# MDNS_HOSTNAME=eidolon-hub
# MDNS_TXT_VERSION=1
# MDNS_API_VERSION=v1
# MDNS_CONFIG_PATH=/api/esp32/config

# =============================================
# Admin 探测配置 (可选)
# =============================================
# ADMIN_PROBE_ENABLED=true
# ADMIN_PROBE_INTERVAL_SECONDS=10
# ADMIN_DEGRADED_AFTER_MISSED_PROBES=2
# ADMIN_OFFLINE_AFTER_MISSED_PROBES=3
# ADMIN_COMMAND_TIMEOUT_SECONDS=30
