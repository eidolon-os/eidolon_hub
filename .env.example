# Eidolon Hub 统一环境变量模板（dev / prod 通用）
#
# 用法：在仓库根目录 `cp .env.example .env`，按本机环境填写。
# 加载方式：hub/config.py 通过 python-dotenv 的 load_dotenv() 读取仓库根 .env。

# Production Hub never receives LiveKit/WSS provider credentials or endpoints.
# Channel providers own those settings and return only opaque bindings.

# Connection lease credentials (at least 32 bytes each)
EIDOLON_HUB_LEASE_SECRET=change-me-to-a-random-connection-lease-secret
EIDOLON_HUB_MANAGEMENT_JWT_SECRET=change-me-to-a-random-management-jwt-secret
EIDOLON_HUB_PROVIDER_TOKEN=change-me-to-a-random-provider-api-token

# Cloud persistence only; settings.yaml selects the PostgreSQL adapter.
# EIDOLON_HUB_POSTGRES_DSN=postgresql://user:password@db/eidolon_hub

# Optional WAN connector credential
# EIDOLON_HUB_MQTT_PASSWORD=

# Optional OTLP collector. No endpoint means no telemetry leaves the process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# =============================================
# API 服务配置 (可选)
# =============================================
# HUB_HOST=0.0.0.0
# HUB_PORT=8081

# =============================================
# 日志配置 (可选)
# =============================================
# LOG_LEVEL=INFO

# =============================================
# mDNS 发现配置 (可选)
# =============================================
# MDNS_SERVICE_TYPE=_eidolon-hub._tcp.local.
# MDNS_SERVICE_NAME=Eidolon Hub._eidolon-hub._tcp.local.
# MDNS_HOSTNAME=eidolon-hub
# MDNS_TXT_VERSION=1
# MDNS_API_VERSION=v1
# MDNS_CONFIG_PATH=/api/config

# =============================================
# Admin 探测配置 (可选)
# =============================================
# ADMIN_PROBE_ENABLED=true
# ADMIN_PROBE_INTERVAL_SECONDS=10
# ADMIN_DEGRADED_AFTER_MISSED_PROBES=2
# ADMIN_OFFLINE_AFTER_MISSED_PROBES=3
# ADMIN_COMMAND_TIMEOUT_SECONDS=30
