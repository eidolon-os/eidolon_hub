# Eidolon Web Client 环境变量
# 复制到 client/web/.env.local 并根据实际环境修改
# 注意: NEXT_PUBLIC_* 变量在构建时嵌入 JS，构建后需重新构建才能生效

# =============================================
# LiveKit 配置
# =============================================
# LiveKit 服务器地址
NEXT_PUBLIC_LIVEKIT_URL=wss://livekit-server.yangtzeailab.com

# Token 获取接口 (通过 Nginx 反向代理到 API 服务)
NEXT_PUBLIC_LIVEKIT_TOKEN_URL=https://eidolon-hub-api.yangtzeailab.com/api/web/config

# =============================================
# App 配置
# =============================================
NEXT_PUBLIC_APP_TITLE=Eidolon Agent

# Daemon WebSocket 地址 (预留，当前未使用)
# NEXT_PUBLIC_DAEMON_WS_URL=ws://localhost:8080/ws
