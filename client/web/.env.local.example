# Eidolon Web Client 环境变量
#
# 用法：cp .env.local.example .env.local
# 默认值对应仓库根 .env 的 dev 本机配置（LiveKit 7880, Hub API 8081）；
# 部署到其它环境时改成对应的 ws(s):// 与 http(s):// 地址。
# 注意：NEXT_PUBLIC_* 在构建时嵌入 JS，改完需重新构建（dev 模式下重启 next dev 即可）。

# =============================================
# LiveKit 配置
# =============================================
# 浏览器直接连 LiveKit 的信令地址（须为 ws:// 或 wss://）
# 局域网调试可改成 ws://<本机 LAN IP>:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880

# Hub 的 token / 配置接口（client_type=web 时返回 accessToken）
NEXT_PUBLIC_LIVEKIT_TOKEN_URL=http://127.0.0.1:8081/api/config

# =============================================
# App 配置
# =============================================
NEXT_PUBLIC_APP_TITLE=Eidolon Agent

# Daemon WebSocket 地址（预留，当前未使用）
# NEXT_PUBLIC_DAEMON_WS_URL=ws://localhost:8080/ws
